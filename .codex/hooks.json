{
  "//": "Generated by scripts/sync-codex.sh from .claude/settings.json. Do not edit by hand.",
  "//note": "Codex CLI hooks. Path uses CODEX_PROJECT_DIR. Hook scripts symlinked from .claude/hooks/.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|shell",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CODEX_PROJECT_DIR:-.}\"/.claude/hooks/check-private-files.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|shell",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CODEX_PROJECT_DIR:-.}\"/.claude/hooks/check-private-files.sh"
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CODEX_PROJECT_DIR:-.}\"/.claude/hooks/check-attribution.sh"
          }
        ]
      }
    ]
  }
}
