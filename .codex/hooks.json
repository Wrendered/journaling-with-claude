{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|shell|exec_command",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CODEX_PROJECT_DIR:-.}\"/.claude/hooks/check-private-files.sh"
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CODEX_PROJECT_DIR:-.}\"/.claude/hooks/memory.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|shell|exec_command",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CODEX_PROJECT_DIR:-.}\"/.claude/hooks/check-private-files.sh"
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CODEX_PROJECT_DIR:-.}\"/.claude/hooks/check-attribution.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CODEX_PROJECT_DIR:-.}\"/.claude/hooks/memory.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CODEX_PROJECT_DIR:-.}\"/.claude/hooks/memory.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CODEX_PROJECT_DIR:-.}\"/.claude/hooks/memory.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CODEX_PROJECT_DIR:-.}\"/.claude/hooks/memory.sh",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
